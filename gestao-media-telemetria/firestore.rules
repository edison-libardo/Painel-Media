rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasAllowedProfile() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['adm', 'consultor'];
    }

    function isAdmin() {
      return hasAllowedProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'adm';
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /sharedDashboard/{documentId} {
      allow read: if hasAllowedProfile();
      allow write: if isAdmin();
    }

    match /sharedHistory/{historyId} {
      allow read: if hasAllowedProfile();
      allow write: if isAdmin();
    }

    match /sharedMeta/{documentId} {
      allow read: if hasAllowedProfile();
      allow write: if isAdmin();
    }
  }
}
